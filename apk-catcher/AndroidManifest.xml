<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.jabs.apkcatcher"
    android:versionCode="2"
    android:versionName="1.1">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:label="APK Catcher"
        android:icon="@android:drawable/stat_sys_download_done"
        android:theme="@style/Invisible"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true">
        <activity
            android:name=".CatchActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <provider
            android:name=".ApkProvider"
            android:authorities="app.jabs.apkcatcher.apks"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
